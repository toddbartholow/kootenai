<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kootenai Console</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; overflow: hidden; background: #1a1a2e; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; }
        .header {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            padding: 10px 16px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            font-size: 14px;
        }
        .header h1 { font-size: 16px; font-weight: 600; }
        .vm-tabs {
            background: #252540;
            padding: 12px 16px 0;
            display: flex;
            gap: 8px;
            border-bottom: 1px solid #3d3d5c;
            overflow: visible;
            position: relative;
            z-index: 50;
        }
        .vm-tab {
            display: flex;
            align-items: center;
            gap: 8px;
            padding: 10px 16px;
            background: #2d2d44;
            border: 1px solid #3d3d5c;
            border-bottom: none;
            border-radius: 8px 8px 0 0;
            cursor: pointer;
            transition: all 0.2s;
            min-width: 120px;
            position: relative;
            top: 1px;
        }
        .vm-tab:hover { background: #3d3d5c; }
        .vm-tab.active {
            background: #1a1a2e;
            border-color: #667eea;
            border-bottom-color: #1a1a2e;
        }
        .vm-tab.active .vm-name { color: white; }
        .status-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            flex-shrink: 0;
        }
        .status-dot.running { background: #22c55e; box-shadow: 0 0 6px #22c55e; }
        .status-dot.stopped { background: #ef4444; }
        .vm-name {
            color: #a0a0b0;
            font-size: 13px;
            font-weight: 500;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .vm-actions { position: relative; margin-left: auto; z-index: 100; }
        .vm-actions-btn {
            background: transparent;
            border: none;
            color: #888;
            cursor: pointer;
            padding: 6px;
            border-radius: 4px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .vm-actions-btn:hover { background: rgba(255,255,255,0.15); color: #ccc; }
        .vm-tab.active .vm-actions-btn { color: #aaa; }
        .vm-tab.active .vm-actions-btn:hover { color: white; }
        .vm-actions-menu {
            position: absolute;
            top: calc(100% + 4px);
            right: -8px;
            background: #2d2d44;
            border: 1px solid #3d3d5c;
            border-radius: 6px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.4);
            min-width: 150px;
            z-index: 200;
            display: none;
            overflow: hidden;
        }
        .vm-actions-menu.show { display: block; }
        .vm-actions-menu button {
            display: flex;
            align-items: center;
            gap: 10px;
            width: 100%;
            padding: 10px 14px;
            background: transparent;
            border: none;
            color: #ccc;
            font-size: 13px;
            cursor: pointer;
            text-align: left;
            transition: background 0.2s;
        }
        .vm-actions-menu button:hover { background: #3d3d5c; }
        .vm-actions-menu button.danger { color: #ef4444; }
        .vm-actions-menu button.danger:hover { background: rgba(239, 68, 68, 0.2); }
        .vm-actions-menu button.success { color: #22c55e; }
        .vm-actions-menu button.success:hover { background: rgba(34, 197, 94, 0.2); }
        .vm-actions-menu .divider { height: 1px; background: #3d3d5c; margin: 4px 0; }
        .vm-actions-menu svg { width: 16px; height: 16px; flex-shrink: 0; }
        .toolbar {
            background: #2d2d44;
            padding: 8px 12px;
            display: flex;
            gap: 8px;
            align-items: center;
            border-bottom: 1px solid #3d3d5c;
            position: relative;
            z-index: 10;
        }
        .toolbar button {
            background: #4a4a6a;
            border: none;
            color: white;
            padding: 6px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 12px;
            transition: background 0.2s;
        }
        .toolbar button:hover { background: #5a5a7a; }
        .toolbar button.active { background: #667eea; }
        .toolbar button.danger { background: #dc3545; }
        .toolbar button.danger:hover { background: #c82333; }
        .toolbar .separator { width: 1px; height: 24px; background: #3d3d5c; margin: 0 4px; }
        .toolbar .spacer { flex: 1; }
        .toolbar .status {
            display: flex;
            align-items: center;
            gap: 6px;
            color: #aaa;
            font-size: 12px;
        }
        .toolbar .status.connected { color: #22c55e; }
        .toolbar .status .dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: currentColor;
        }
        #vnc-container {
            height: calc(100% - 140px);
            background: #000;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
        }
        .loading { color: white; text-align: center; }
        .loading .spinner {
            width: 40px; height: 40px;
            border: 3px solid #333;
            border-top-color: #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
            margin: 0 auto 16px;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .error { color: #ef4444; text-align: center; padding: 20px; }
        .error button {
            margin-top: 16px;
            background: #667eea;
            border: none;
            color: white;
            padding: 10px 20px;
            border-radius: 6px;
            cursor: pointer;
        }
        .switching-overlay {
            position: absolute;
            inset: 0;
            background: rgba(0,0,0,0.8);
            display: none;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            color: white;
            z-index: 100;
        }
        .switching-overlay.active { display: flex; }
        .notification {
            position: fixed;
            top: 20px;
            right: 20px;
            padding: 12px 20px;
            background: #667eea;
            color: white;
            border-radius: 8px;
            font-size: 14px;
            z-index: 1000;
            box-shadow: 0 4px 20px rgba(0,0,0,0.3);
            animation: slideIn 0.3s ease;
        }
        .notification.success { background: #22c55e; }
        .notification.error { background: #ef4444; }
        @keyframes slideIn {
            from { transform: translateX(100px); opacity: 0; }
            to { transform: translateX(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="header">
        <h1>Kootenai Console</h1>
        <span>{{.LabName}}</span>
    </div>
    <div class="vm-tabs" id="vmTabs"></div>
    <div class="toolbar">
        <button id="btn-ctrl">Ctrl</button>
        <button id="btn-alt">Alt</button>
        <div class="separator"></div>
        <button id="btn-tab">Tab</button>
        <button id="btn-esc">Esc</button>
        <button id="btn-cad" class="danger">Ctrl+Alt+Del</button>
        <div class="separator"></div>
        <button id="btn-fullscreen">Fullscreen</button>
        <div class="spacer"></div>
        <div class="status" id="connectionStatus">
            <span class="dot"></span>
            <span>Connecting...</span>
        </div>
    </div>
    <div id="vnc-container">
        <div class="loading">
            <div class="spinner"></div>
            <p>Connecting to VM...</p>
        </div>
        <div class="switching-overlay" id="switchingOverlay">
            <div class="spinner" style="border-top-color:#667eea;"></div>
            <div>Switching to <span id="switchingTo"></span>...</div>
        </div>
    </div>
    <script type="module">
        import RFB from '/static/novnc/core/rfb.js';
        const vmList = {{.VMList}};
        const wsBaseURL = {{.WSBaseURL}};
        const initialPassword = {{.InitialPassword}};
        let currentVMIndex = 0;
        let rfb = null;
        let ctrlPressed = false, altPressed = false;
        let currentPassword = initialPassword;
        const container = document.getElementById('vnc-container');
        const statusEl = document.getElementById('connectionStatus');
        const tabsContainer = document.getElementById('vmTabs');
        function buildTabs() {
            tabsContainer.innerHTML = vmList.map((vm, i) =>
                '<div class="vm-tab ' + (i === 0 ? 'active' : '') + '" data-index="' + i + '">' +
                    '<span class="status-dot ' + (vm.status === 'running' ? 'running' : 'stopped') + '" onclick="window.switchVM(' + i + ')"></span>' +
                    '<span class="vm-name" onclick="window.switchVM(' + i + ')">' + vm.name + '</span>' +
                    '<div class="vm-actions">' +
                        '<button class="vm-actions-btn" onclick="window.toggleMenu(event, ' + i + ')" title="VM Actions">' +
                            '<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">' +
                                '<circle cx="8" cy="2.5" r="1.5"/><circle cx="8" cy="8" r="1.5"/><circle cx="8" cy="13.5" r="1.5"/>' +
                            '</svg>' +
                        '</button>' +
                        '<div class="vm-actions-menu" id="menu-' + i + '">' +
                            '<button class="success" onclick="window.vmAction(' + i + ', \'start\')">' +
                                '<svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>Start</button>' +
                            '<button onclick="window.vmAction(' + i + ', \'reboot\')">' +
                                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 4v6h6M23 20v-6h-6"/><path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/></svg>Reboot</button>' +
                            '<div class="divider"></div>' +
                            '<button class="danger" onclick="window.vmAction(' + i + ', \'shutdown\')">' +
                                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.36 6.64a9 9 0 1 1-12.73 0M12 2v10"/></svg>Shutdown</button>' +
                            '<button class="danger" onclick="window.vmAction(' + i + ', \'stop\')">' +
                                '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>Force Stop</button>' +
                        '</div>' +
                    '</div>' +
                '</div>'
            ).join('');
        }
        function updateStatus(text, connected) {
            statusEl.className = 'status ' + (connected ? 'connected' : '');
            statusEl.innerHTML = '<span class="dot"></span><span>' + text + '</span>';
        }
        function showNotification(msg, type = 'info') {
            const n = document.createElement('div');
            n.className = 'notification ' + type;
            n.textContent = msg;
            document.body.appendChild(n);
            setTimeout(() => n.remove(), 3000);
        }
        function showError(msg) {
            const vncArea = container.querySelector(':not(.switching-overlay)') || container;
            vncArea.innerHTML = '<div class="error"><p>' + msg + '</p><button onclick="location.reload()">Retry</button></div>';
        }
        async function getVNCTicket(vmid, node) {
            try {
                const resp = await fetch('/api/v1/proxmox/vms/' + vmid + '/console?node=' + node + '&type=vnc');
                if (!resp.ok) throw new Error('Failed to get ticket');
                const data = await resp.json();
                return data.Ticket || data.ticket;
            } catch (err) {
                console.error('Failed to get VNC ticket:', err);
                return null;
            }
        }
        async function connect(vm, password) {
            if (rfb) { rfb.disconnect(); rfb = null; }
            const wsURL = wsBaseURL + '/' + vm.vmid + '/vnc?node=' + vm.node;
            updateStatus('Connecting...', false);
            const overlay = document.getElementById('switchingOverlay');
            container.innerHTML = '';
            container.appendChild(overlay);
            try {
                rfb = new RFB(container, wsURL, {
                    credentials: { password: password },
                    scaleViewport: true,
                    resizeSession: true
                });
                rfb.addEventListener('connect', () => {
                    updateStatus('Connected', true);
                    rfb.focus();
                    overlay.classList.remove('active');
                });
                rfb.addEventListener('disconnect', (e) => {
                    updateStatus('Disconnected', false);
                    if (!e.detail.clean) showError('Connection lost');
                });
                rfb.addEventListener('securityfailure', (e) => {
                    updateStatus('Auth failed', false);
                    showError('Authentication failed: ' + (e.detail.reason || 'Invalid credentials'));
                });
            } catch (err) {
                updateStatus('Failed', false);
                showError('Failed to connect: ' + err.message);
                overlay.classList.remove('active');
            }
        }
        window.switchVM = async function(index) {
            if (index === currentVMIndex) return;
            const vm = vmList[index];
            document.getElementById('switchingTo').textContent = vm.name;
            document.getElementById('switchingOverlay').classList.add('active');
            document.querySelectorAll('.vm-tab').forEach((tab, i) => {
                tab.classList.toggle('active', i === index);
            });
            currentVMIndex = index;
            const ticket = await getVNCTicket(vm.vmid, vm.node);
            if (ticket) currentPassword = ticket;
            await connect(vm, currentPassword);
        };
        window.toggleMenu = function(event, index) {
            event.stopPropagation();
            document.querySelectorAll('.vm-actions-menu').forEach((m, i) => {
                if (i !== index) m.classList.remove('show');
            });
            document.getElementById('menu-' + index).classList.toggle('show');
        };
        document.addEventListener('click', (e) => {
            if (!e.target.closest('.vm-actions')) {
                document.querySelectorAll('.vm-actions-menu').forEach(m => m.classList.remove('show'));
            }
        });
        window.vmAction = async function(index, action) {
            document.getElementById('menu-' + index).classList.remove('show');
            const vm = vmList[index];
            showNotification(action.charAt(0).toUpperCase() + action.slice(1) + 'ing ' + vm.name + '...', 'info');
            try {
                const resp = await fetch('/api/v1/proxmox/vms/' + vm.vmid + '/' + action + '?node=' + vm.node, { method: 'POST' });
                if (resp.ok) {
                    showNotification(vm.name + ' ' + action + ' initiated', 'success');
                    const dot = document.querySelectorAll('.vm-tab')[index].querySelector('.status-dot');
                    if (action === 'start') { dot.className = 'status-dot running'; vmList[index].status = 'running'; }
                    else if (action === 'stop' || action === 'shutdown') { dot.className = 'status-dot stopped'; vmList[index].status = 'stopped'; }
                } else {
                    showNotification('Failed to ' + action + ' ' + vm.name, 'error');
                }
            } catch (err) {
                showNotification('Error: ' + err.message, 'error');
            }
        };
        document.getElementById('btn-ctrl').addEventListener('click', function() {
            ctrlPressed = !ctrlPressed;
            this.classList.toggle('active', ctrlPressed);
        });
        document.getElementById('btn-alt').addEventListener('click', function() {
            altPressed = !altPressed;
            this.classList.toggle('active', altPressed);
        });
        document.getElementById('btn-tab').addEventListener('click', () => { if (rfb) rfb.sendKey(0xFF09); });
        document.getElementById('btn-esc').addEventListener('click', () => { if (rfb) rfb.sendKey(0xFF1B); });
        document.getElementById('btn-cad').addEventListener('click', () => { if (rfb) rfb.sendCtrlAltDel(); });
        document.getElementById('btn-fullscreen').addEventListener('click', () => {
            if (!document.fullscreenElement) document.documentElement.requestFullscreen();
            else document.exitFullscreen();
        });
        buildTabs();
        connect(vmList[0], initialPassword);
    </script>
</body>
</html>
