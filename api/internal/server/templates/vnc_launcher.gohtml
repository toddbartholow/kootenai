<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Kootenai - {{.CourseName}}</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body {
            height: 100%;
            background: linear-gradient(135deg, #1a1a2e 0%, #16213e 100%);
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
        }
        .container {
            height: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
            text-align: center;
        }
        .card {
            background: rgba(255,255,255,0.1);
            backdrop-filter: blur(10px);
            border-radius: 16px;
            padding: 40px;
            max-width: 500px;
            width: 100%;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .icon {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 20px;
            margin: 0 auto 24px;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .icon svg { width: 40px; height: 40px; fill: white; }
        h1 { color: white; font-size: 24px; margin-bottom: 8px; }
        .course { color: rgba(255,255,255,0.7); font-size: 16px; margin-bottom: 8px; }
        .user { color: rgba(255,255,255,0.5); font-size: 14px; margin-bottom: 32px; }
        .status {
            background: rgba(34, 197, 94, 0.2);
            color: #22c55e;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 14px;
            margin-bottom: 24px;
            display: inline-block;
        }
        .status::before {
            content: '';
            display: inline-block;
            width: 8px;
            height: 8px;
            background: #22c55e;
            border-radius: 50%;
            margin-right: 8px;
            animation: pulse 2s infinite;
        }
        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }
        .launch-btn {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border: none;
            padding: 16px 48px;
            font-size: 18px;
            font-weight: 600;
            border-radius: 12px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            display: inline-flex;
            align-items: center;
            gap: 12px;
        }
        .launch-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 40px rgba(102, 126, 234, 0.4);
        }
        .launch-btn svg { width: 24px; height: 24px; fill: currentColor; }
        .hint {
            color: rgba(255,255,255,0.5);
            font-size: 13px;
            margin-top: 20px;
        }
        .info {
            margin-top: 32px;
            padding-top: 24px;
            border-top: 1px solid rgba(255,255,255,0.1);
            color: rgba(255,255,255,0.6);
            font-size: 13px;
        }
        .info strong { color: rgba(255,255,255,0.8); }
    </style>
</head>
<body>
    <div class="container">
        <div class="card">
            <div class="icon">
                <svg viewBox="0 0 24 24"><path d="M20 3H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h8v2H8v2h8v-2h-4v-2h8c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 12H4V5h16v10z"/></svg>
            </div>
            <h1>Lab Environment Ready</h1>
            <p class="course">{{.CourseName}}</p>
            <p class="user">{{.UserName}}</p>
            <div class="status">VM Running</div>
            <br><br>
            <button onclick="openConsole()" class="launch-btn">
                <svg viewBox="0 0 24 24"><path d="M19 19H5V5h7V3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z"/></svg>
                Open Console
            </button>
            <p class="hint">Opens in a new window (tip: right-click for "Open in new tab")</p>
    <script>
        function openConsole() {
            // Using window.open without features - browsers prefer tabs over popups
            // noopener and noreferrer for security
            var url = {{.ConsoleURL}};
            var w = window.open(url, '_blank', 'noopener,noreferrer');
            if (!w || w.closed || typeof w.closed == 'undefined') {
                // Popup blocked - try anchor fallback
                var a = document.createElement('a');
                a.href = url;
                a.target = '_blank';
                a.rel = 'noopener noreferrer';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
            }
        }
    </script>
            <div class="info">
                <p><strong>VMs:</strong> {{.VMCount}} virtual machine(s)</p>
            </div>
        </div>
    </div>
</body>
</html>
