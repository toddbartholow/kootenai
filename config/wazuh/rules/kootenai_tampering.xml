<!--
  Kootenai Tampering Detection Rules for Wazuh

  These rules detect attempts by students to tamper with or disable
  the Wazuh agent during lab sessions.

  Installation:
    1. Copy to /var/ossec/etc/rules/kootenai_tampering.xml
    2. Add to ossec.conf: <include>rules/kootenai_tampering.xml</include>
    3. Restart Wazuh manager: systemctl restart wazuh-manager

  Rule ID Range: 100200 - 100299 (reserved for Kootenai tampering)
-->
<group name="kootenai,tampering,">

  <!-- ============================================================ -->
  <!-- WAZUH AGENT SERVICE TAMPERING -->
  <!-- ============================================================ -->

  <!-- Detect attempts to stop Wazuh agent service -->
  <rule id="100200" level="15">
    <if_sid>5402</if_sid>
    <match>wazuh-agent|ossec-agent</match>
    <description>CRITICAL: Attempt to stop Wazuh agent service detected</description>
    <group>tampering,agent_stop,</group>
  </rule>

  <!-- Detect systemctl commands targeting Wazuh -->
  <rule id="100201" level="14">
    <if_group>audit_command</if_group>
    <match>systemctl</match>
    <regex>stop|disable|mask</regex>
    <match>wazuh|ossec</match>
    <description>Attempt to disable Wazuh agent via systemctl</description>
    <group>tampering,agent_stop,</group>
  </rule>

  <!-- Detect service command targeting Wazuh -->
  <rule id="100202" level="14">
    <if_group>audit_command</if_group>
    <match>service</match>
    <regex>wazuh|ossec</regex>
    <regex>stop</regex>
    <description>Attempt to stop Wazuh agent via service command</description>
    <group>tampering,agent_stop,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- WAZUH PROCESS TAMPERING -->
  <!-- ============================================================ -->

  <!-- Detect kill commands targeting Wazuh processes -->
  <rule id="100210" level="15">
    <if_group>audit_command</if_group>
    <match>kill|pkill|killall</match>
    <regex>wazuh|ossec</regex>
    <description>CRITICAL: Attempt to kill Wazuh agent process</description>
    <group>tampering,process_kill,</group>
  </rule>

  <!-- Detect process termination signals to Wazuh -->
  <rule id="100211" level="14">
    <if_group>audit_command</if_group>
    <match>kill -9|kill -KILL|kill -TERM</match>
    <description>Aggressive process termination signal detected</description>
    <group>tampering,process_kill,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- WAZUH CONFIGURATION TAMPERING -->
  <!-- ============================================================ -->

  <!-- Detect modifications to Wazuh configuration files -->
  <rule id="100220" level="14">
    <if_sid>550,553,554</if_sid>
    <match>/var/ossec/etc/ossec.conf|/var/ossec/etc/client.keys</match>
    <description>Wazuh agent configuration file modified</description>
    <group>tampering,config_change,</group>
  </rule>

  <!-- Detect deletion of Wazuh configuration -->
  <rule id="100221" level="15">
    <if_sid>553</if_sid>
    <match>/var/ossec/</match>
    <description>CRITICAL: Wazuh file deleted</description>
    <group>tampering,config_delete,</group>
  </rule>

  <!-- Detect changes to Wazuh agent keys -->
  <rule id="100222" level="15">
    <if_sid>550,554</if_sid>
    <match>client.keys</match>
    <description>CRITICAL: Wazuh agent keys modified</description>
    <group>tampering,key_change,</group>
  </rule>

  <!-- Detect chmod/chown on Wazuh files -->
  <rule id="100223" level="12">
    <if_group>audit_command</if_group>
    <match>chmod|chown</match>
    <match>/var/ossec</match>
    <description>Permission change on Wazuh files detected</description>
    <group>tampering,permission_change,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- NETWORK TAMPERING (BLOCKING WAZUH TRAFFIC) -->
  <!-- ============================================================ -->

  <!-- Detect iptables rules that might block Wazuh -->
  <rule id="100230" level="13">
    <if_group>audit_command</if_group>
    <match>iptables|ip6tables|nft</match>
    <regex>DROP|REJECT</regex>
    <regex>1514|1515|55000</regex>
    <description>Firewall rule blocking Wazuh ports detected</description>
    <group>tampering,network_block,</group>
  </rule>

  <!-- Detect UFW rules blocking Wazuh -->
  <rule id="100231" level="13">
    <if_group>audit_command</if_group>
    <match>ufw</match>
    <regex>deny|reject</regex>
    <description>UFW rule that may block monitoring traffic</description>
    <group>tampering,network_block,</group>
  </rule>

  <!-- Detect hosts file modifications (DNS poisoning) -->
  <rule id="100232" level="12">
    <if_sid>550,554</if_sid>
    <match>/etc/hosts</match>
    <description>Hosts file modified - possible DNS redirection</description>
    <group>tampering,dns_change,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- WAZUH BINARY TAMPERING -->
  <!-- ============================================================ -->

  <!-- Detect modifications to Wazuh binaries -->
  <rule id="100240" level="15">
    <if_sid>550,554</if_sid>
    <match>/var/ossec/bin/</match>
    <description>CRITICAL: Wazuh binary modified</description>
    <group>tampering,binary_change,</group>
  </rule>

  <!-- Detect replacement of Wazuh agent binary -->
  <rule id="100241" level="15">
    <if_group>audit_command</if_group>
    <match>cp|mv</match>
    <match>/var/ossec/bin/</match>
    <description>CRITICAL: Attempt to replace Wazuh binary</description>
    <group>tampering,binary_replace,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- PRIVILEGE ESCALATION FOR TAMPERING -->
  <!-- ============================================================ -->

  <!-- Detect sudo commands targeting Wazuh -->
  <rule id="100250" level="13">
    <if_group>sudo</if_group>
    <match>wazuh|ossec|/var/ossec</match>
    <description>Privileged command targeting Wazuh detected</description>
    <group>tampering,privilege_escalation,</group>
  </rule>

  <!-- Detect su to root followed by Wazuh commands -->
  <rule id="100251" level="12">
    <if_sid>5303</if_sid>
    <description>User gained root shell - monitor for tampering</description>
    <group>tampering,privilege_escalation,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- PROCESS HIDING / ROOTKIT ATTEMPTS -->
  <!-- ============================================================ -->

  <!-- Detect LD_PRELOAD usage (library injection) -->
  <rule id="100260" level="14">
    <if_group>audit_command</if_group>
    <match>LD_PRELOAD</match>
    <description>LD_PRELOAD detected - possible process hiding attempt</description>
    <group>tampering,library_injection,</group>
  </rule>

  <!-- Detect /proc manipulation -->
  <rule id="100261" level="13">
    <if_group>audit_command</if_group>
    <match>/proc/</match>
    <regex>mount|bind</regex>
    <description>Proc filesystem manipulation detected</description>
    <group>tampering,proc_manipulation,</group>
  </rule>

  <!-- ============================================================ -->
  <!-- COMPOSITE RULES (CORRELATION) -->
  <!-- ============================================================ -->

  <!-- Multiple tampering attempts in short time -->
  <rule id="100290" level="15" frequency="3" timeframe="300">
    <if_matched_group>tampering</if_matched_group>
    <description>CRITICAL: Multiple tampering attempts detected - session compromised</description>
    <group>tampering,multiple_attempts,</group>
  </rule>

  <!-- Tampering followed by checkpoint completion (suspicious) -->
  <rule id="100291" level="15">
    <if_matched_group>tampering</if_matched_group>
    <description>Tampering detected before checkpoint completion - verify manually</description>
    <group>tampering,suspicious_completion,</group>
  </rule>

</group>
