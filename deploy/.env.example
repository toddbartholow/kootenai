# Kootenai Platform - Environment Configuration
#
# Copy this file to .env and fill in the required values.
# Required fields are marked with [REQUIRED]
#
# Generate secrets with: openssl rand -base64 32

# =============================================================================
# Database Configuration
# =============================================================================
DATABASE_USER=labadmin
# [REQUIRED] PostgreSQL password
DATABASE_PASSWORD=
DATABASE_NAME=virtuallab
# TLS mode for the database connection. The variable is DATABASE_SSL_MODE
# (with the underscore) — DATABASE_SSLMODE is not read by anything.
#
# Valid values are only those the PostgreSQL driver (lib/pq) implements:
#   disable, require, verify-ca, verify-full
# libpq's "allow" and "prefer" are NOT supported and fail at connect time.
#
# Defaults to `disable`, because the bundled postgres:16-alpine service in
# docker-compose.yml is built with ssl=off and cannot accept a TLS connection.
# That is only safe because that Postgres is not port-published and is reached
# over the internal Docker bridge.
#
# RAISE THIS for any non-local deployment. If DATABASE_HOST points at a Postgres
# outside this compose file — a managed service, another VM, anything crossing a
# network you do not control — set `require` at minimum, or `verify-full` to
# also authenticate the server certificate. Leaving it at `disable` there sends
# credentials and lab data in cleartext.
DATABASE_SSL_MODE=disable

# =============================================================================
# Proxmox Configuration
# =============================================================================
# The Proxmox cluster where lab VMs will be created
# [REQUIRED] e.g., https://<PROXMOX_IP>:8006
PROXMOX_HOST=
# [REQUIRED] e.g., <PROXMOX_TOKEN_ID>
PROXMOX_TOKEN_ID=
# [REQUIRED] API token secret
PROXMOX_TOKEN=
PROXMOX_NODE=pve                # Default node name
PROXMOX_INSECURE=false          # TLS verification (set true ONLY for dev with self-signed certs)

# =============================================================================
# Authentication
# =============================================================================
# [REQUIRED] Generate with: openssl rand -base64 32
JWT_SECRET=
JWT_EXPIRATION=24h
AUTH_DEMO_MODE=false            # DANGER: Set to true only for demos (bypasses auth)

# =============================================================================
# CloudStack Configuration (optional)
# =============================================================================
# CLOUDSTACK_URL=
# CLOUDSTACK_API_KEY=
# CLOUDSTACK_SECRET_KEY=
# CLOUDSTACK_INSECURE=true

# =============================================================================
# Wazuh SIEM Integration (optional)
# =============================================================================
# WAZUH_MANAGER_URL=https://wazuh.example.com:55000
# WAZUH_API_USER=wazuh-api
# WAZUH_API_PASSWORD=

# =============================================================================
# Canvas LMS Integration (optional)
# =============================================================================
# CANVAS_URL=https://canvas.example.edu
# CANVAS_CLIENT_ID=
# CANVAS_DEPLOYMENT_ID=

# =============================================================================
# Redis Configuration
# =============================================================================
REDIS_ENABLED=true
REDIS_HOST=redis
REDIS_PORT=6379
# [REQUIRED] Generate with: openssl rand -base64 32
REDIS_PASSWORD=

# =============================================================================
# NATS Configuration
# =============================================================================
# [REQUIRED] Generate with: openssl rand -base64 32
NATS_PASSWORD=

# =============================================================================
# Service Ports
# =============================================================================
API_PORT=8080
WEB_PORT=3000

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=info                  # debug, info, warn, error
LOG_FORMAT=json                 # json or text

# =============================================================================
# Monitoring (Prometheus & Grafana)
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
# [REQUIRED] Generate with: openssl rand -base64 16
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=http://localhost:3001

# =============================================================================
# Security Tools (docker-compose.security.yml)
# =============================================================================
# DefectDojo - Vulnerability Management Dashboard
DEFECTDOJO_PORT=8081
DEFECTDOJO_DB_PASSWORD=defectdojo    # CHANGE in production!
DEFECTDOJO_ADMIN_PASSWORD=admin      # CHANGE in production!
# REQUIRED: Generate with: openssl rand -base64 32
DEFECTDOJO_SECRET_KEY=
# REQUIRED: Must be exactly 32 characters
DEFECTDOJO_AES_KEY=
DEFECTDOJO_REDIS_PASSWORD=redispass  # CHANGE in production!
DEFECTDOJO_ALLOWED_HOSTS=localhost,defectdojo  # Restrict to known hostnames

# OWASP ZAP
ZAP_PORT=8090                        # ZAP Web UI
ZAP_API_PORT=8091                    # ZAP API

# =============================================================================
# Development
# =============================================================================
DEV_MODE=false

# =============================================================================
# Monitoring
# =============================================================================
# Optional. When set, GET /metrics requires `Authorization: Bearer <token>`.
# Leave blank and the endpoint is open to anything that can reach the port.
#
# If you set this you MUST also uncomment the `authorization:` block on the
# kootenai-api job in deploy/prometheus/prometheus.yml and paste the same
# value there — Prometheus cannot read this variable. Setting it in only one
# place makes every scrape 401 and fires the APIDown alert.
METRICS_TOKEN=
