# Kootenai API Environment Configuration
# Copy to /etc/kootenai/env and fill in values
# Used by labctl.service (systemd)

DATABASE_HOST=127.0.0.1
DATABASE_USER=labadmin
DATABASE_PASSWORD=
DATABASE_NAME=virtuallab

NATS_URL=nats://127.0.0.1:4222

PROXMOX_HOST=https://<PROXMOX_IP>:8006
PROXMOX_TOKEN_ID=
PROXMOX_TOKEN=
PROXMOX_INSECURE=false

JWT_SECRET=
AUTH_DEMO_MODE=false
AUTH_COOKIE_MODE=true
DEV_MODE=false
LOG_LEVEL=info
