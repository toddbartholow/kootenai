{
  "name": "kootenai-ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:check": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint src --ext .vue,.ts,.tsx --max-warnings 0",
    "lint:fix": "eslint src --ext .vue,.ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,css,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,css,json,md}\"",
    "generate:api-types": "swagger2openapi --warnOnly --outfile /tmp/kootenai-openapi3.yaml ../api/docs/swagger.json && openapi-typescript /tmp/kootenai-openapi3.yaml --output src/api/generated/schema.ts",
    "check:api-types": "swagger2openapi --warnOnly --outfile /tmp/kootenai-openapi3.yaml ../api/docs/swagger.json && openapi-typescript /tmp/kootenai-openapi3.yaml --output /tmp/schema-regen.ts && diff -q /tmp/schema-regen.ts src/api/generated/schema.ts",
    "check:i18n-parity": "node scripts/i18n-check-parity.mjs",
    "i18n:audit": "node scripts/i18n-audit.mjs",
    "dev:pseudo": "VITE_I18N_PSEUDO=1 vite",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "prepare": "cd .. && husky web/.husky || true"
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,vue}": [
      "eslint --fix --max-warnings 0 --no-warn-ignored",
      "prettier --write"
    ],
    "src/**/*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@novnc/novnc": "^1.5.0",
    "@spice-project/spice-html5": "^0.2.1",
    "axios": "^1.15.2",
    "chart.js": "^4.4.7",
    "dompurify": "3.4.14",
    "pinia": "^2.1.0",
    "pinia-plugin-persistedstate": "^3.2.3",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.2",
    "tailwind-merge": "^2.5.0",
    "vis-data": "^8.0.4",
    "vis-network": "^10.0.3",
    "vue": "^3.4.0",
    "vue-i18n": "^11.3.2",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.17",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-vue": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.15",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^9.0.0",
    "eslint-plugin-vuejs-accessibility": "^2.5.0",
    "globals": "^17.1.0",
    "happy-dom": "^20.9.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^15.2.10",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.4.2",
    "swagger2openapi": "^7.0.8",
    "tailwindcss": "^4.1.17",
    "typescript": "^5.3.0",
    "vite": "^7.3.2",
    "vitest": "^4.0.15",
    "vue-tsc": "^2.0.0"
  }
}
